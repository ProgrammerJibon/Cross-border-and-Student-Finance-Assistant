APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=FinBridge AI
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=finbridge_ai
DB_USER=finbridge
DB_PASSWORD=replace-with-local-password
SESSION_SECRET=replace-with-at-least-32-random-characters
