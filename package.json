    "db:migrate": "node scripts/migrate.mjs",
    "test:e2e": "playwright test",
    "test:agent": "node --conditions=react-server --import tsx --test tests/agent.integration.ts",
    "test:agent:e2e": "playwright test --config playwright.agent.config.ts",
    "test:payments": "node --conditions=react-server --import tsx --test tests/payments.integration.ts",
    "billing:check": "node scripts/check-payment-providers.mjs",
    "test:billing": "node --conditions=react-server --import tsx --test tests/billing.integration.ts",
    "test:isolation": "node --conditions=react-server --import tsx --test tests/isolation.integration.ts",
    "finance:reconcile": "node --conditions=react-server --import tsx scripts/reconcile.ts",
    "finance:bootstrap": "node scripts/bootstrap-live-admin.mjs",
    "test:wallet": "node scripts/run-isolated-tests.mjs integration tests/wallet-workflows.integration.ts tests/admin-bootstrap.integration.ts",
    "test:integration": "node scripts/run-isolated-tests.mjs integration"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
