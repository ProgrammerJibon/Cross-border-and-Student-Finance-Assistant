  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "rmdir .next /s /q && next build && xcopy \"public\" \".next\\standalone\\public\" /E /I /Y && xcopy \".next\\static\" \".next\\standalone\\.next\\static\" /E /I /Y && copy \".env.production\" \".next\\standalone\\.env.production\" /Y && copy \".env.production\" \".next\\standalone\\.env\" /Y && node scripts/patch-standalone.mjs && exit 0",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "db:setup": "node scripts/setup.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "test:e2e": "playwright test",
    "test:agent": "node --conditions=react-server --import tsx --test tests/agent.integration.ts",
    "test:agent:e2e": "playwright test --config playwright.agent.config.ts",
    "test:payments": "node --conditions=react-server --import tsx --test tests/payments.integration.ts"
  },
