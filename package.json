    "@mui/material-nextjs": "^9.5.0",
    "@mui/x-charts": "^9.15.0",
    "@xyflow/react": "^12.12.0",
    "bcryptjs": "^3.0.3",
    "decimal.js": "^10.6.0",
    "jose": "^6.2.12",
    "mysql2": "^3.24.5",
    "next": "^16.4.2",
    "openai": "^7.32.0",
    "papaparse": "^5.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
